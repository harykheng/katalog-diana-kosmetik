# Salin jadi .env untuk development lokal, dan isi juga di Vercel
# (Project Settings → Environment Variables).
#
# Ambil dari Supabase Dashboard → Settings → API.
# Pakai ANON key, JANGAN service_role key: service_role melewati RLS dan akan
# membocorkan seluruh data ERP ke browser siapa pun yang membuka katalog.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
